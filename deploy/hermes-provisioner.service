# Host-side helper (tools/hermes-provisioner). Install to /etc/systemd/system/.
# It runs on the host, never in the antares container, which has no Docker access.
[Unit]
Description=Antares Hermes provisioner
After=docker.service network-online.target
Requires=docker.service

[Service]
# A normal host user in the `docker` group, nothing more. Not root.
User=antares-prov
Group=antares-prov
SupplementaryGroups=docker
# Holds PROVISIONER_TOKEN (and optionally HERMES_CONTAINER). Root-owned, mode 0600, under /opt/antares (outside the repo).
EnvironmentFile=/opt/antares/provisioner.env
# Bind to the docker bridge gateway so the antares container (host.docker.internal) can reach it
# and the edge cannot: never 0.0.0.0, never a public address. Set to the gateway of hermes_edge,
# see deploy/README.md. 127.0.0.1 is not reachable from a container.
Environment=PROVISIONER_ADDR=172.17.0.1:8750
ExecStart=/opt/antares/bin/hermes-provisioner
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
