# Variable NAMES with placeholder values. Real values come from runtime secrets, never this file.
# Optional, with defaults (shown commented): ANTARES_ADDR=:8080,
# ANTARES_ADMIN_GOOGLE_ISSUER=https://accounts.google.com
# Development only: serve the frontend from this directory instead of the embedded bundle.
# ANTARES_STATIC_DIR=
ANTARES_DB_PATH=<absolute-path-to-sqlite-file>
# Required. base64 of 32 random bytes, e.g. `head -c32 /dev/urandom | base64`. No default.
ANTARES_SECRET_KEY=<base64-of-32-random-bytes>
# Required. Google OAuth web client (https://console.cloud.google.com/apis/credentials). No defaults:
# a missing value refuses startup. Redirect URI to register: <ANTARES_PUBLIC_ORIGIN>/api/auth/google/callback
ANTARES_GOOGLE_CLIENT_ID=<google-oauth-client-id>
ANTARES_GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
# Required. Public origin of this deployment, scheme included, no path: https://antares.example.com
ANTARES_PUBLIC_ORIGIN=your-antares-origin
# Required. Private origin of the Hermes API (no path), reachable from this container: http://hermes:8642
ANTARES_HERMES_URL=<hermes-private-origin>
# Required. Origin of the host-side helper tools/hermes-provisioner as reachable from this container,
# and its bearer token (>= 32 chars; the same value the helper was started with).
ANTARES_PROVISIONER_URL=<provisioner-origin>
ANTARES_PROVISIONER_TOKEN=<provisioner-bearer-token>
# Optional. Comma-separated toolsets a tenant profile may have enabled; default: web,vision,image_gen,skills,memory,todo,clarify.
# terminal, file, code_execution, delegation, cronjob, session_search, connections and browser can never be listed.
# ANTARES_TENANT_ALLOWED_TOOLSETS=
# Set the same list as PROVISIONER_ALLOWED_TOOLSETS on the provisioner, or toolset_policy fails verification.
# Optional Web Push (set both or neither; without them the UI shows notifications as unavailable).
# Private key: base64url of a raw 32-byte P-256 scalar, generated once and kept (changing it drops every device's
# subscription). Subject: a mailto: or https:// contact the push services may use.
# ANTARES_VAPID_PRIVATE_KEY=<base64url-of-32-byte-p256-scalar>
# ANTARES_VAPID_SUBJECT=mailto:<operator-contact>
# Optional admin bootstrap (all-or-nothing): the known Google identity to make the first admin.
ANTARES_ADMIN_GOOGLE_SUB=<google-sub>
ANTARES_ADMIN_EMAIL=<admin-email>

# --- Deploy (deploy/compose.yml, deploy/README.md) ---
# Read by `docker compose`, not by Antares. Full commit SHA of the image to run, and the path of the
# env file (outside the repo) holding the variables above.
ANTARES_TAG=<full-commit-sha>
ANTARES_ENV_FILE=<path-to-env-file-outside-repo>
# Host helper (deploy/hermes-provisioner.service), in /opt/antares/provisioner.env. The token must
# equal ANTARES_PROVISIONER_TOKEN. PROVISIONER_ADDR must never be 0.0.0.0.
PROVISIONER_TOKEN=<provisioner-bearer-token>
# HERMES_CONTAINER=hermes
# PROVISIONER_ADDR=172.17.0.1:8750

# Per-account request limits; positive integers only. Defaults shown; restart to apply changes.
# Fixed one-minute windows for run/message attempts and upload attempts.
# ANTARES_RUNS_PER_MINUTE=30
# ANTARES_MESSAGES_PER_MINUTE=60
# ANTARES_UPLOADS_PER_MINUTE=10
# ANTARES_ARTIFACTS_PER_MINUTE=60
# Concurrent SSE connections per account (released when the request ends).
# ANTARES_SSE_CONNECTIONS=4
