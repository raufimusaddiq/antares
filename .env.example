# Variable NAMES with placeholder values. Real values come from runtime secrets, never this file.
ANTARES_ADDR=:8080
ANTARES_DB_PATH=/data/antares.db
ANTARES_STATIC_DIR=web/dist
# Required. base64 of 32 random bytes, e.g. `head -c32 /dev/urandom | base64`. No default.
ANTARES_SECRET_KEY=replace-with-base64-of-32-random-bytes
# Optional admin bootstrap (all-or-nothing): the known Google identity to make the first admin.
ANTARES_ADMIN_GOOGLE_ISSUER=https://accounts.google.com
ANTARES_ADMIN_GOOGLE_SUB=replace-with-google-sub
ANTARES_ADMIN_EMAIL=admin@example.invalid
